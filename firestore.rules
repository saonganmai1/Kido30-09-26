rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if true;
    }
    match /dailyTasks/{taskId} {
      allow read, write: if true;
    }
    match /rewards/{rewardId} {
      allow read, write: if true;
    }
    match /parentNotes/{noteId} {
      allow read, write: if true;
    }
    match /leaderboard/{rankId} {
      allow read, write: if true;
    }
    match /vipTransactions/{txId} {
      allow read, write: if true;
    }
    match /journalEntries/{entryId} {
      allow read, write: if true;
    }
    match /accountAuditLogs/{logId} {
      allow read, write: if true;
    }
    match /userLoginLogs/{sessionId} {
      allow read, write: if true;
    }
    match /systemBroadcasts/{broadcastId} {
      allow read, write: if true;
    }
    match /adminUndoStack/{undoId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
